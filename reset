#!/bin/sh

set -eu

die() {
    printf '\nERROR: %s\n' "$*" >&2
    exit 1
}

success() {
    printf '\nOK: %s\n' "$*"
}

info() {
    printf '\nINFO: %s\n' "$*"
}

BASEDIR="$(dirname "$(readlink -f "$0")")"

cd "${BASEDIR}" || die "Could not change to ${BASEDIR}"

command -v docker >/dev/null 2>&1 || die "docker is required"
command -v sudo >/dev/null 2>&1 || die "sudo is required"

info "Removing existing deployment containers"
sudo docker compose down --remove-orphans || die "Failed to remove docker compose services"

info "Running install"
"${BASEDIR}/install" || die "Install failed"

success "Reset complete"
