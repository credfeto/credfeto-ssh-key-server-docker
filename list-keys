#!/bin/sh

set -eu

die() {
    printf '\n\033[31m✗\033[0m %s\n' "$*" >&2
    exit 1
}

print_usage() {
    cat <<'USAGE'
Usage: ./list-keys [--host <host>] [--username <username>]

Lists the SSH public keys held by the key server.

Options:
  --host <host>          Only list keys for this host.
  --username <username>  Only list keys for this user.
  -h, --help             Show this help.
USAGE
}

usage_error() {
    printf '%s\n\n' "$*" >&2
    print_usage >&2
    exit 2
}

require_value() {
    [ "$#" -ge 2 ] || usage_error "$1 requires a value"
}

host=""
username=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --host)
            require_value "$@"
            host="$2"
            shift 2
            ;;
        --username)
            require_value "$@"
            username="$2"
            shift 2
            ;;
        -h | --help)
            print_usage
            exit 0
            ;;
        *)
            usage_error "Unknown option: $1"
            ;;
    esac
done

BASEDIR="$(dirname "$(readlink -f "$0")")"
ENV_FILE="${BASEDIR}/.env"

cd "${BASEDIR}" || die "Could not change to ${BASEDIR}"

command -v docker >/dev/null 2>&1 || die "docker is required"
command -v sudo >/dev/null 2>&1 || die "sudo is required"
[ -f "${ENV_FILE}" ] || die "${ENV_FILE} is missing - run ./install first"

set --
[ -z "${host}" ] || set -- "$@" --host "${host}"
[ -z "${username}" ] || set -- "$@" --username "${username}"

# The key store refuses files not owned by the server's own UID, so run as the image's runtime user.
exec sudo docker compose exec -T --user 1654:1654 ssh-key-server \
    /usr/src/app/Credfeto.Keys.Server list "$@"
